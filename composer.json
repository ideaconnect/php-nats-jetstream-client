{
  "name": "idct/php-nats-jetstream-client",
  "description": "Async-first NATS + JetStream client for PHP 8.2+",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "amphp/amp": "^3.1",
    "amphp/socket": "^2.3",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "IDCT\\NATS\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IDCT\\NATS\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "stan": "phpstan analyse",
    "fix": "php-cs-fixer fix"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
